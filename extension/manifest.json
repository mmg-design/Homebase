{
  "manifest_version": 3,
  "name": "Rule of 100 Quick Log",
  "version": "1.0.0",
  "description": "Floating outreach logger for the Daily Actions tracker. Log outreach from any tab without switching back.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Rule of 100"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://homebase-pearl.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://homebase-pearl.vercel.app/tracker*", "http://localhost/*"],
      "js": ["content-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://homebase-pearl.vercel.app/*"],
      "js": ["content-widget.js"],
      "run_at": "document_idle"
    }
  ]
}
